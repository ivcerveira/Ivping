<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.input.KeyCodeCombination?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!--        Algumas opções Unicode, sem ícones ou dependências:-->
<!--        •-->
<!--        × — limpar/fechar; visualmente mais elegante que X-->
<!--        •-->
<!--        ✕ — versão um pouco mais destacada-->
<!--        •-->
<!--        ✖ — versão preenchida e mais pesada-->
<!--        •-->
<!--        ⌫ — apagar, semelhante à tecla Backspace-->
<!--        •-->
<!--        ⌧ — limpar conteúdo de um campo-->
<!--        •-->
<!--        ↺ — restaurar/reiniciar-->
<!--        •-->
<!--        ⟲ — redefinir pesquisa-->
<!--        •-->
<!--        – — remover, embora seja menos intuitivo-->

<BorderPane prefHeight="460.0" prefWidth="813.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nuapps.ivping.controller.IvpingController">
    <top>
        <VBox BorderPane.alignment="CENTER">
            <MenuBar BorderPane.alignment="CENTER">
                <Menu text="_Arquivo">
                    <MenuItem onAction="#handleCloseApp" text="Sai_r">
                        <accelerator>
                            <KeyCodeCombination alt="UP" code="Q" control="DOWN" meta="UP" shift="UP" shortcut="UP" />
                        </accelerator>
                    </MenuItem>
                </Menu>
                <Menu text="_Ferramentas">
                    <MenuItem onAction="#onPingClicked" text="_Ping">
                        <accelerator>
                            <KeyCodeCombination alt="UP" code="P" control="DOWN" meta="UP" shift="UP" shortcut="UP" />
                        </accelerator>
                    </MenuItem>
                    <MenuItem onAction="#openSSHSession" text="SS_H">
                        <accelerator>
                            <KeyCodeCombination alt="UP" code="S" control="DOWN" meta="UP" shift="UP" shortcut="UP" />
                        </accelerator>
                    </MenuItem>
                    <MenuItem onAction="#openTelnetSession" text="_Telnet">
                        <accelerator>
                            <KeyCodeCombination alt="UP" code="T" control="DOWN" meta="UP" shift="UP" shortcut="UP" />
                        </accelerator></MenuItem>
                    <MenuItem onAction="#openIvpingDataFolder" text="A_brir pasta 'Ivping_data'" />
                    <MenuItem onAction="#onPingByIpClicked" text="Ping por IP..." />
                    <MenuItem onAction="#onIpSubnetCalculatorClicked" text="IP Subnet Calculator" />

                </Menu>
                <Menu text="Aj_uda">
                    <MenuItem onAction="#showAboutDialog" text="_Sobre o Ivping..." />
                </Menu>
            </MenuBar>

            <ToolBar prefHeight="40.0" BorderPane.alignment="CENTER">
                <BorderPane.margin>
                    <Insets />
                </BorderPane.margin>
                <padding>
                    <Insets left="12.0" />
                </padding>
                <Button fx:id="pingButton" mnemonicParsing="false" onAction="#onPingClicked">
                    <graphic>
                        <ImageView fitHeight="25.0" fitWidth="25.0" pickOnBounds="true" preserveRatio="true">
                            <Image url="@../../../images/ping24.png" />
                        </ImageView>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Ping (Ctrl+P)" />
                    </tooltip></Button>
                <CheckBox fx:id="chkPingContinuous" mnemonicParsing="false" text="-t" />
                <Separator visible="false" />
                <Button mnemonicParsing="false" onAction="#openSSHSession">
                    <graphic>
                        <ImageView fitHeight="25.0" fitWidth="25.0" pickOnBounds="true" preserveRatio="true">
                            <Image url="@../../../images/browser24.png" />
                        </ImageView>
                    </graphic>
                    <tooltip>
                        <Tooltip text="SSH (Ctrl+S)" />
                    </tooltip></Button>
                <Separator visible="false" />
<!--                <TextField fx:id="searchTextField" prefWidth="250.0" promptText="Pesquisar..." stylesheets="@my_theme.css" />-->
                <StackPane prefWidth="250.0" stylesheets="@my_theme.css">
                    <TextField fx:id="txtSearch" maxWidth="Infinity" promptText="Pesquisar..." styleClass="search-text-field" />
                    <Button focusTraversable="false" mnemonicParsing="false" onAction="#clearTextField" styleClass="clear-search-button" text="⌧" StackPane.alignment="CENTER_RIGHT">
                        <StackPane.margin>
                            <Insets right="4.0" />
                        </StackPane.margin>
                        <tooltip>
                            <Tooltip text="Limpar" />
                        </tooltip>
                    </Button>
                </StackPane>
                <Pane prefWidth="4.0" />
                <Button mnemonicParsing="false" onAction="#onAdvancedSearchClicked" text="Pesquisa Avançada" />
                <Separator orientation="VERTICAL" />
                <HBox alignment="CENTER_LEFT" spacing="6.0">
                    <Button fx:id="tmnButton" mnemonicParsing="false" text="TMN" textAlignment="CENTER">
                        <tooltip>
                            <Tooltip text="TMN" />
                        </tooltip>
                        <font>
                            <Font name="System Bold" size="12.0" />
                        </font>
                    </Button>
                    <Button fx:id="ciscoprimeButton" mnemonicParsing="false" text="Cisco Prime">
                        <tooltip>
                            <Tooltip text="Cisco Prime" />
                        </tooltip>
                        <font>
                            <Font name="System Bold" size="12.0" />
                        </font>
                    </Button>
                    <Button fx:id="zabbixButton" mnemonicParsing="false" text="Zabbix">
                        <tooltip>
                            <Tooltip text="Zabbix" />
                        </tooltip>
                        <font>
                            <Font name="System Bold" size="12.0" />
                        </font>
                    </Button>
                    <Button fx:id="sigmonButton" mnemonicParsing="false" text="Sigmon">
                        <font>
                            <Font name="System Bold" size="12.0" />
                        </font>
                        <tooltip>
                            <Tooltip text="Sigmon" />
                        </tooltip>
                    </Button>
                    <Button fx:id="grafanaButton" mnemonicParsing="false" text="Grafana">
                        <font>
                            <Font name="System Bold" size="12.0" />
                        </font>
                        <tooltip>
                            <Tooltip text="Grafana" />
                        </tooltip>
                    </Button>
                </HBox>
            </ToolBar>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tableView" stylesheets="@my_theme.css" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="colHost" text="Hostname" />
                <TableColumn fx:id="colIp" text="IP Address" />
                <TableColumn fx:id="colLocation" text="Device Location" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </center>
</BorderPane>
